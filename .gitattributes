# Normalize line endings in the repository to LF, check out per platform.
# Without this, Windows contributors see LF/CRLF churn on every commit.
* text=auto eol=lf

# Binary assets: never attempt text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary

# Generated evidence fixtures and sample reports are text; keep them LF.
examples/*.json text eol=lf
examples/*.md text eol=lf
